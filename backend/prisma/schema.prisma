// This is your Prisma schema file.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RoomStatus {
  LOBBY
  PLAYING
  FINISHED
}

enum PlayerRole {
  MAFIA
  DOCTOR
  POLICE
  CIVILIAN
}

enum GamePhase {
  LOBBY
  ROLE_ASSIGNMENT
  NIGHT
  DISCUSSION
  VOTING
  ELIMINATION
  FINISHED
}

enum NightStep {
  ALL_SLEEP
  MAFIA_WAKE
  MAFIA_CHOOSE
  DOCTOR_WAKE
  DOCTOR_CHOOSE
  POLICE_WAKE
  POLICE_CHOOSE
  NIGHT_END
}

model GameRoom {
  id                 String     @id @default(cuid())
  code               String     @unique
  status             RoomStatus @default(LOBBY)
  phase              GamePhase  @default(LOBBY)
  currentRoundNumber Int        @default(0)
  nightStep          NightStep?
  nightState         Json?
  hostPlayerId       String?

  players Player[]
  rounds  GameRound[]
  votes Vote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([phase])
}

model Player {
  id                  String      @id @default(cuid())
  roomId              String
  username            String
  isHost              Boolean     @default(false)
  role                PlayerRole?
  reconnectSecretHash String
  isConnected         Boolean     @default(false)
  isAlive             Boolean     @default(true)
  joinedAt            DateTime    @default(now())
  lastSeenAt          DateTime    @default(now())

  votesCast     Vote[] @relation("VotesCast")
  votesReceived Vote[] @relation("VotesReceived")

  room GameRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, username])
  @@index([roomId, isConnected])
  @@index([roomId, role])
  @@index([roomId, isAlive])
}

model GameRound {
  id          String    @id @default(cuid())
  roomId      String
  roundNumber Int
  phase       GamePhase @default(NIGHT)
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  room GameRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, roundNumber])
  @@index([roomId, phase])
}

model Vote {
  id          String   @id @default(cuid())
  roomId      String
  roundNumber Int
  attempt     Int      @default(1)
  voterId     String
  targetId    String
  createdAt   DateTime @default(now())

  room   GameRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  voter  Player   @relation("VotesCast", fields: [voterId], references: [id], onDelete: Cascade)
  target Player   @relation("VotesReceived", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([roomId, roundNumber, attempt, voterId])
  @@index([roomId, roundNumber, attempt])
  @@index([targetId])
}